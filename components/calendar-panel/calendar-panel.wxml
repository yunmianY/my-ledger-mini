<view class="cal">
  <view class="cal-head">
    <view class="cal-nav" bindtap="prev" hover-class="cal-nav-hover" hover-stay-time="60">
      <text class="cal-nav-text">‹</text>
    </view>
    <text class="cal-title">{{label}}</text>
    <view class="cal-nav" bindtap="next" hover-class="cal-nav-hover" hover-stay-time="60">
      <text class="cal-nav-text">›</text>
    </view>
  </view>

  <view class="cal-week">
    <text wx:for="{{weekdays}}" wx:key="*this" class="cal-week-item">{{item}}</text>
  </view>

  <view class="cal-grid">
    <view
      wx:for="{{cells}}"
      wx:key="key"
      class="cal-cell"
      data-date="{{item.date}}"
      bindtap="onDay"
      hover-class="cal-cell-hover"
      hover-stay-time="60"
    >
      <view class="cal-day {{item.selected ? 'cal-selected' : ''}} {{item.isToday ? 'cal-today' : ''}}">
        <text class="cal-day-text {{item.selected ? 'cal-day-text-on' : ''}} {{item.inMonth ? '' : 'cal-day-text-out'}}">{{item.day}}</text>
      </view>
    </view>
  </view>
</view>

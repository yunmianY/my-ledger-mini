.cal {
  display: flex;
  flex-direction: column;
}

.cal-week {
  display: flex;
  flex-direction: row;
  padding-bottom: 8rpx;
}

.cal-week-item {
  width: 14.2857%;
  text-align: center;
  font-size: 20rpx;
  color: #b0b0b0;
}

.cal-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.cal-cell {
  width: 14.2857%;
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  border-radius: 14rpx;
}

.cal-hover {
  opacity: 0.6;
}

.cal-day {
  font-size: 24rpx;
  color: #1a1a1a;
  line-height: 28rpx;
}

.cal-day-empty {
  color: transparent;
}

.cal-today {
  color: #e4572e;
  font-weight: 700;
}

.cal-amount {
  font-size: 16rpx;
  line-height: 20rpx;
  color: #6b6b6b;
  margin-top: 2rpx;
}

.cal-selected {
  border-color: #e4572e;
}

/* 支出热度 */
.heat-e-1 {
  background: rgba(228, 87, 46, 0.08);
}

.heat-e-2 {
  background: rgba(228, 87, 46, 0.18);
}

.heat-e-3 {
  background: rgba(228, 87, 46, 0.3);
}

/* 收入热度 */
.heat-i-1 {
  background: rgba(42, 157, 143, 0.08);
}

.heat-i-2 {
  background: rgba(42, 157, 143, 0.18);
}

.heat-i-3 {
  background: rgba(42, 157, 143, 0.3);
}

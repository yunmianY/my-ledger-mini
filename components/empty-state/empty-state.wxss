.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 48rpx;
}

.empty-emoji {
  font-size: 72rpx;
  line-height: 96rpx;
  opacity: 0.7;
}

.empty-text {
  font-size: 28rpx;
  color: #8a8a8a;
  margin-top: 16rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #b0b0b0;
  margin-top: 8rpx;
  text-align: center;
}

.kb {
  flex: none;
  display: flex;
  flex-direction: row;
  background: #f1f1ee;
  padding: 8rpx;
  padding-bottom: calc(8rpx + env(safe-area-inset-bottom));
}

.kb-keys {
  width: 75%;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.key {
  width: 33.3333%;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 12rpx;
}

.key-hover {
  background: rgba(0, 0, 0, 0.06);
}

.key-text {
  font-size: 42rpx;
  color: #1a1a1a;
  font-weight: 500;
}

.kb-side {
  width: 25%;
  display: flex;
  flex-direction: column;
  padding-left: 8rpx;
}

.key-side {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  margin: 2rpx 0;
}

.key-again {
  background: #ffffff;
}

.key-save {
  background: #e4572e;
}

.key-disabled {
  opacity: 0.4;
}

.key-side-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.key-side-text-light {
  color: #ffffff;
}

.tabbar {
  flex: none;
  display: flex;
  flex-direction: row;
  background: #ffffff;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  padding-bottom: env(safe-area-inset-bottom);
}

.tab {
  flex: 1;
  height: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab-hover {
  opacity: 0.6;
}

.tab-emoji {
  font-size: 38rpx;
  line-height: 38rpx;
  opacity: 0.4;
}

.tab-icon {
  width: 56rpx;
  height: 56rpx;
  opacity: 0.45;
}

.tab-icon-on {
  opacity: 1;
}

.tab-label {
  font-size: 22rpx;
  line-height: 30rpx;
  color: #8a8a8a;
  margin-top: 8rpx;
}

.tab-on {
  opacity: 1;
  color: #e4572e;
  font-weight: 600;
}

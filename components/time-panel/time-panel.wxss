.tp {
  display: flex;
  flex-direction: column;
}

.tp-preview {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  padding: 4rpx 4rpx 16rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.tp-preview-label {
  font-size: 24rpx;
  color: #8a8a8a;
}

.tp-preview-value {
  font-size: 48rpx;
  font-weight: 600;
  color: #e4572e;
  line-height: 52rpx;
}

.tp-presets {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding: 16rpx 0 4rpx;
}

.tp-preset {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #f7f7f5;
  margin: 0 12rpx 12rpx 0;
}

.tp-preset-text {
  font-size: 22rpx;
  color: #1a1a1a;
}

.tp-hover {
  opacity: 0.6;
}

.tp-label {
  font-size: 22rpx;
  color: #a0a0a0;
  margin: 12rpx 0 8rpx;
}

.tp-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.tp-cell {
  width: 12.5%;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
}

.tp-cell-minute {
  width: 8.3333%;
  height: 52rpx;
}

.tp-on {
  background: #fdeee8;
  border-color: #e4572e;
}

.tp-cell-text {
  font-size: 24rpx;
  color: #1a1a1a;
}

.tp-cell-text-on {
  color: #e4572e;
  font-weight: 600;
}

.tp-actions {
  display: flex;
  flex-direction: row;
  margin-top: 24rpx;
}

.tp-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.tp-btn-last {
  margin-right: 0;
}

.tp-btn-ghost {
  background: #f7f7f5;
}

.tp-btn-primary {
  background: #e4572e;
}

.tp-btn-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.tp-btn-text-light {
  color: #ffffff;
}

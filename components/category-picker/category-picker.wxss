.cats {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.cat {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
}

.cat-hover {
  opacity: 0.6;
}

.cat-emoji-wrap {
  width: 84rpx;
  height: 84rpx;
  border-radius: 28rpx;
  background: #f5f3ee;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.cat-emoji-on {
  background: #fdeee8;
  border-color: #e4572e;
}

.cat-emoji {
  font-size: 40rpx;
  line-height: 44rpx;
}

.cat-icon-img {
  width: 100%;
  height: 100%;
  border-radius: 28rpx;
}

.cat-name {
  font-size: 22rpx;
  color: #8a8a8a;
  margin-top: 10rpx;
}

.cat-name-on {
  color: #e4572e;
  font-weight: 600;
}

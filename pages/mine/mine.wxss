.book-card {
  background: #ffffff;
  margin: 8rpx 24rpx 20rpx;
  padding: 32rpx 28rpx;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.book-left {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.book-emoji {
  font-size: 56rpx;
  margin-right: 20rpx;
}

.book-icon-gap {
  margin-right: 20rpx;
}

.book-info {
  display: flex;
  flex-direction: column;
}

.book-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.book-sub {
  font-size: 22rpx;
  color: #a0a0a0;
  margin-top: 4rpx;
}

.book-arrow {
  font-size: 24rpx;
  color: #e4572e;
}

.stat-row {
  display: flex;
  flex-direction: row;
  margin: 0 24rpx 20rpx;
}

.stat-item {
  flex: 1;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  margin-right: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-item-last {
  margin-right: 0;
}

.stat-value {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.stat-small {
  font-size: 22rpx;
  color: #8a8a8a;
}

.stat-label {
  font-size: 20rpx;
  color: #a0a0a0;
  margin-top: 6rpx;
}

.menu {
  padding: 4rpx 28rpx;
}

.row-left {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.row-icon {
  display: flex;
  align-items: center;
  margin-right: 16rpx;
}

.row-value-text {
  font-size: 24rpx;
  color: #a0a0a0;
}

.hint {
  font-size: 22rpx;
  color: #b0b0b0;
  margin: 8rpx 40rpx 24rpx;
  line-height: 32rpx;
}

.member-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.member-name {
  font-size: 30rpx;
  color: #1a1a1a;
}

.member-del {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: #fdecea;
}

.member-del-text {
  font-size: 22rpx;
  color: #d64545;
}

.add-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 24rpx;
}

.add-input {
  flex: 1;
  height: 80rpx;
  background: #f7f7f5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.add-btn {
  margin-left: 16rpx;
  height: 80rpx;
  padding: 0 32rpx;
  border-radius: 16rpx;
  background: #e4572e;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-btn-text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 600;
}

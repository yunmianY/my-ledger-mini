.info-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
}

.info-label {
  font-size: 26rpx;
  color: #8a8a8a;
}

.info-value {
  font-size: 26rpx;
  color: #1a1a1a;
}

.action {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.action-last {
  border-bottom: 0;
}

.action-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.action-title {
  font-size: 30rpx;
  color: #1a1a1a;
}

.action-danger {
  color: #d64545;
}

.action-sub {
  font-size: 22rpx;
  color: #a0a0a0;
  margin-top: 6rpx;
  line-height: 32rpx;
}

.action-arrow {
  font-size: 30rpx;
  color: #c0c0c0;
  margin-left: 16rpx;
}

.paste-label {
  font-size: 24rpx;
  color: #8a8a8a;
  margin-bottom: 12rpx;
}

.paste-area {
  width: 100%;
  height: 220rpx;
  background: #f7f7f5;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  color: #1a1a1a;
}

.btn-row {
  display: flex;
  flex-direction: row;
  margin-top: 24rpx;
}

.btn-half {
  flex: 1;
  margin-right: 16rpx;
}

.btn-half-last {
  margin-right: 0;
}

.import-btn {
  margin-top: 24rpx;
}

.import-hint {
  font-size: 22rpx;
  color: #b0b0b0;
  line-height: 32rpx;
  margin-top: 16rpx;
}

.tip {
  font-size: 22rpx;
  color: #b0b0b0;
  line-height: 34rpx;
  margin: 16rpx 40rpx 0;
}

/* ---- 导出范围 ---- */
.opt-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.opt-row-last {
  border-bottom: 0;
}

.opt-label {
  font-size: 28rpx;
  color: #8a8a8a;
  flex: none;
  width: 150rpx;
}

.opt-group {
  flex: 1;
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
}

.opt {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: #f5f3ee;
  margin-left: 16rpx;
}

.opt-on {
  background: #fdeee8;
}

.opt-text {
  font-size: 24rpx;
  color: #8a8a8a;
}

.opt-text-on {
  color: #e4572e;
  font-weight: 600;
}

.opt-value {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
}

.opt-value-text {
  font-size: 28rpx;
  color: #1a1a1a;
}

.opt-arrow {
  font-size: 26rpx;
  color: #c0c0c0;
  margin-left: 10rpx;
}

/* ---- 日期弹层 ---- */
.date-clear {
  margin-top: 24rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #f7f7f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.date-clear-text {
  font-size: 28rpx;
  color: #8a8a8a;
}

/* ---- 分类多选弹层 ---- */
.cat-group {
  margin-bottom: 24rpx;
}

.cat-group-title {
  font-size: 22rpx;
  color: #a0a0a0;
  margin-bottom: 12rpx;
}

.cat-chips {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.cat-chip {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #f7f7f5;
  margin: 0 12rpx 12rpx 0;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.cat-chip-on {
  background: #fdeee8;
  border-color: #e4572e;
}

.cat-chip-text {
  font-size: 24rpx;
  color: #5a5a5a;
}

.cat-chip-text-on {
  color: #e4572e;
  font-weight: 600;
}

.cat-actions {
  display: flex;
  flex-direction: row;
  margin-top: 8rpx;
}

.cat-btn {
  flex: 1;
  margin-right: 16rpx;
}

.cat-btn-last {
  margin-right: 0;
}

.month-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 8rpx 24rpx 20rpx;
}

.month-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: #ffffff;
}

.month-arrow {
  font-size: 32rpx;
  color: #1a1a1a;
  line-height: 32rpx;
}

.month-text {
  font-size: 30rpx;
  font-weight: 600;
  margin: 0 16rpx;
}

.today-btn {
  margin-left: 12rpx;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  background: #fdeee8;
}

.today-text {
  font-size: 22rpx;
  color: #e4572e;
}

.total-card {
  background: #ffffff;
  margin: 0 24rpx 20rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
}

.total-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.total-label {
  font-size: 26rpx;
  color: #8a8a8a;
}

.type-switch {
  display: flex;
  flex-direction: row;
  background: #f7f7f5;
  border-radius: 999rpx;
  padding: 4rpx;
}

.type-item {
  padding: 6rpx 22rpx;
  font-size: 22rpx;
  color: #8a8a8a;
  border-radius: 999rpx;
}

.type-on {
  background: #ffffff;
  color: #1a1a1a;
  font-weight: 600;
}

.total-value {
  font-size: 64rpx;
  font-weight: 600;
  margin-top: 16rpx;
  line-height: 72rpx;
}

.text-expense {
  color: #e4572e;
}

.text-income {
  color: #2a9d8f;
}

.total-sub {
  display: flex;
  flex-direction: row;
  margin-top: 12rpx;
}

.total-sub-item {
  font-size: 24rpx;
  color: #a0a0a0;
  margin-right: 28rpx;
}

.card-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.cat-row {
  display: flex;
  flex-direction: column;
  padding: 16rpx 0;
}

.cat-row-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 10rpx;
}

.cat-emoji {
  font-size: 30rpx;
  margin-right: 12rpx;
}

.cat-icon-img {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  margin-right: 12rpx;
}

.icon-gap {
  margin-right: 12rpx;
}

.cat-name-wrap {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  min-width: 0;
}

.cat-name {
  font-size: 28rpx;
  color: #1a1a1a;
}

.cat-count {
  font-size: 20rpx;
  color: #a8a8a8;
  margin-left: 10rpx;
}

.cat-amount {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 600;
  margin-right: 16rpx;
}

.cat-percent {
  font-size: 24rpx;
  color: #8a8a8a;
  width: 90rpx;
  text-align: right;
}

.year-nav {
  display: flex;
  flex-direction: row;
}

.year-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background: #f5f3ee;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
}

.year-arrow {
  font-size: 28rpx;
  color: #1a1a1a;
  line-height: 28rpx;
}

.chart-hint {
  font-size: 20rpx;
  color: #c0c0c0;
  margin-top: 16rpx;
  text-align: center;
}

.card-hint {
  font-size: 20rpx;
  color: #b0b0b0;
}

/* 视图切换 */
.view-switch {
  display: flex;
  flex-direction: row;
  background: #f7f7f5;
  border-radius: 999rpx;
  padding: 4rpx;
}

.view-item {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}

.view-on {
  background: #ffffff;
}

.view-text {
  font-size: 20rpx;
  color: #8a8a8a;
}

.view-text-on {
  color: #e4572e;
  font-weight: 600;
}

.head-right {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.cat-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0 4rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  margin-top: 8rpx;
}

.cat-toggle-text {
  font-size: 24rpx;
  color: #e4572e;
}

/* 饼图图例 */
.pie-legend {
  display: flex;
  flex-direction: column;
  margin-top: 8rpx;
}

.legend-item {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.legend-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
  flex: none;
}

.legend-icon {
  margin-right: 10rpx;
}

.legend-name {
  font-size: 26rpx;
  color: #1a1a1a;
  flex: 1;
  overflow: hidden;
}

.legend-bar {
  width: 120rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #f0eee9;
  margin: 0 14rpx;
  overflow: hidden;
  flex: none;
}

.legend-bar-fill {
  height: 8rpx;
  border-radius: 999rpx;
}

.legend-percent {
  width: 76rpx;
  text-align: right;
  font-size: 22rpx;
  color: #8a8a8a;
  flex: none;
}

.pie-hint {
  font-size: 20rpx;
  color: #c0c0c0;
  margin-top: 8rpx;
  text-align: center;
}

.day-sum {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 4rpx 16rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
  margin-bottom: 8rpx;
}

.day-sum-total {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.day-sum-count {
  font-size: 22rpx;
  color: #8a8a8a;
}

.day-list {
  display: flex;
  flex-direction: column;
}

.day-scroll {
  width: 100%;
}

.day-more {
  padding: 16rpx 0 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.day-more-text {
  font-size: 22rpx;
  color: #b0b0b0;
}

.bill-entry {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.bill-entry-text {
  font-size: 26rpx;
  color: #e4572e;
}

.bill-entry-arrow {
  font-size: 26rpx;
  color: #e4572e;
}

/* ---------- 攒钱进度 ---------- */
.progress-card {
  background: #ffffff;
  margin: 8rpx 24rpx 20rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
}

.progress-top {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
}

.progress-left {
  display: flex;
  flex-direction: column;
}

.progress-label {
  font-size: 24rpx;
  color: #8a8a8a;
}

.progress-amount-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  margin-top: 6rpx;
}

.progress-amount {
  font-size: 52rpx;
  font-weight: 700;
  color: #e4572e;
  line-height: 60rpx;
}

.progress-count {
  font-size: 22rpx;
  color: #a0a0a0;
  margin-left: 12rpx;
}

.progress-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  padding-top: 6rpx;
}

.progress-monthly {
  font-size: 22rpx;
  color: #8a8a8a;
}

.progress-edit {
  font-size: 22rpx;
  color: #e4572e;
  margin-top: 6rpx;
}

.progress-track {
  height: 12rpx;
  border-radius: 999rpx;
  background: #f2f0eb;
  margin-top: 22rpx;
  overflow: hidden;
}

.progress-fill {
  height: 12rpx;
  border-radius: 999rpx;
  background: #2a9d8f;
}

.progress-foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.progress-text {
  font-size: 22rpx;
  color: #a0a0a0;
  flex: 1;
  margin-right: 16rpx;
}

.progress-bought {
  font-size: 22rpx;
  color: #2a9d8f;
  flex: none;
}

/* ---------- 列表 ---------- */
.list {
  background: #ffffff;
  border-radius: 24rpx;
  margin: 0 24rpx;
  overflow: hidden;
}

.item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  border: 2rpx solid #d4d4d4;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  margin-right: 16rpx;
  box-sizing: border-box;
}

.check-on {
  background: #2a9d8f;
  border-color: #2a9d8f;
}

.check-mark {
  font-size: 22rpx;
  color: #ffffff;
  line-height: 22rpx;
}

.thumb {
  width: 88rpx;
  height: 88rpx;
  border-radius: 18rpx;
  flex: none;
  margin-right: 18rpx;
  background: #f5f3ee;
}

.thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.thumb-emoji {
  font-size: 36rpx;
  opacity: 0.5;
}

.item-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.item-line {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.item-name {
  flex: 1;
  font-size: 30rpx;
  color: #1a1a1a;
  margin-right: 12rpx;
}

.item-name-done {
  color: #a0a0a0;
  text-decoration: line-through;
}

.item-price {
  flex: none;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.item-price-done {
  color: #b8b8b8;
  font-weight: 400;
}

.item-priority {
  font-size: 20rpx;
  margin-right: 12rpx;
  flex: none;
}

.item-tag {
  font-size: 20rpx;
  color: #8a8a8a;
  background: #f2f2ef;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-right: 12rpx;
  flex: none;
}

.item-note {
  flex: 1;
  font-size: 22rpx;
  color: #a8a8a8;
}

.tip {
  font-size: 22rpx;
  color: #b0b0b0;
  line-height: 34rpx;
  margin: 24rpx 40rpx 0;
}

/* ---------- 表单 ---------- */
.form-tip {
  font-size: 24rpx;
  color: #8a8a8a;
  margin: 14rpx 0 10rpx;
}

.form-input {
  height: 80rpx;
  background: #f7f7f5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.img-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.form-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  background: #f7f7f5;
  flex: none;
}

.form-thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed rgba(0, 0, 0, 0.12);
}

.form-thumb-plus {
  font-size: 40rpx;
  color: #c0c0c0;
  line-height: 40rpx;
}

.img-clear {
  margin-left: 20rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #fdecea;
}

.img-clear-text {
  font-size: 22rpx;
  color: #d64545;
}

.opt-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.opt {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #f7f7f5;
  margin: 0 12rpx 12rpx 0;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.opt-on {
  background: #fdeee8;
  border-color: #e4572e;
}

.opt-text {
  font-size: 24rpx;
  color: #5a5a5a;
}

.opt-text-on {
  color: #e4572e;
  font-weight: 600;
}

.form-btn {
  margin-top: 28rpx;
}

.overview {
  background: #ffffff;
  margin: 8rpx 24rpx 20rpx;
  padding: 24rpx 28rpx 28rpx;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
}

.month-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding-bottom: 8rpx;
}

.month-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: #f5f3ee;
}

.month-arrow {
  font-size: 32rpx;
  color: #1a1a1a;
  line-height: 32rpx;
}

.month-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin: 0 16rpx;
}

.today-btn {
  margin-left: 12rpx;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  background: #fdeee8;
}

.today-text {
  font-size: 22rpx;
  color: #e4572e;
}

.amount-row {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  padding-top: 24rpx;
}

.amount-block {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.amount-label {
  font-size: 22rpx;
  color: #8a8a8a;
}

.amount-value {
  font-size: 38rpx;
  font-weight: 600;
  margin-top: 6rpx;
  color: #1a1a1a;
}

.amount-expense {
  color: #e4572e;
}

.amount-income {
  color: #2a9d8f;
}

.budget {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
}

.budget-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.budget-label {
  font-size: 24rpx;
  color: #8a8a8a;
}

.budget-text {
  font-size: 24rpx;
  color: #8a8a8a;
}

.budget-text-ok {
  color: #8a8a8a;
}

.budget-text-warn {
  color: #b7791f;
}

.budget-text-over {
  color: #d64545;
}

.budget-track {
  height: 12rpx;
  border-radius: 999rpx;
  background: #f0eee9;
  margin-top: 12rpx;
  overflow: hidden;
}

.budget-fill {
  height: 12rpx;
  border-radius: 999rpx;
}

.budget-fill-ok {
  background: #f4a261;
}

.budget-fill-warn {
  background: #e9b949;
}

.budget-fill-over {
  background: #d64545;
}

.budget-detail {
  font-size: 22rpx;
  color: #b0b0b0;
  margin-top: 10rpx;
}

.day-group {
  display: flex;
  flex-direction: column;
  margin-bottom: 8rpx;
}

.day-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx 12rpx;
}

.day-date {
  font-size: 24rpx;
  color: #8a8a8a;
  font-weight: 600;
}

.day-sum {
  font-size: 22rpx;
  color: #b0b0b0;
}

.day-card {
  background: #ffffff;
  border-radius: 24rpx;
  margin: 0 24rpx;
  overflow: hidden;
}

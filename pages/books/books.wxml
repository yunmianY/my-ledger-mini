<view class="page">
  <page-bg />

  <view class="page-body">
    <navigation-bar title="账本" back="{{true}}" color="#1A1A1A" background="transparent"></navigation-bar>

  <view class="page-main">
    <scroll-view class="scroller" type="list" scroll-y>
      <view class="list">
        <view
          wx:for="{{books}}"
          wx:key="id"
          class="book-row"
          data-id="{{item.id}}"
          bindtap="onSelect"
          hover-class="tap-hover"
        >
          <app-icon icon-key="{{item.iconKey}}" path="{{item.iconPath}}" emoji="{{item.emoji}}" size="{{52}}" />
          <view class="book-row-main">
            <text class="book-row-name">{{item.name}}</text>
            <text class="book-row-sub">{{item.subText}}</text>
          </view>
          <text wx:if="{{item.active}}" class="book-tag">当前</text>
          <view class="book-more" data-id="{{item.id}}" catchtap="onMore" hover-class="tap-hover">
            <text class="book-more-text">⋯</text>
          </view>
        </view>
      </view>

      <view class="add-wrap">
        <view class="btn btn-ghost" bindtap="openAdd" hover-class="btn-hover">
          <text>＋ 新建账本</text>
        </view>
      </view>

      <empty-state wx:if="{{books.length === 0}}" emoji="📚" text="还没有账本" />
      <view class="bottom-space"></view>
    </scroll-view>
  </view>
  </view>

  <sheet show="{{showForm}}" title="{{formTitle}}" bind:close="closeForm">
    <view class="form-tip">账本名称</view>
    <input
      class="form-input"
      value="{{formName}}"
      placeholder="例如：日常、旅行、装修"
      placeholder-class="placeholder"
      maxlength="12"
      bindinput="onName"
    />
    <view class="form-tip">图标</view>
    <view class="icon-row">
      <view class="icon-preview">
        <app-icon icon-key="{{formIconKey}}" path="{{formIconPath}}" emoji="{{formEmoji}}" size="{{52}}" />
      </view>
      <view class="icon-actions">
        <view class="icon-btn" bindtap="onPickIcon" hover-class="tap-hover">
          <text class="icon-btn-text">上传图片</text>
        </view>
        <view wx:if="{{formIconPath}}" class="icon-btn icon-btn-ghost" bindtap="onClearIcon" hover-class="tap-hover">
          <text class="icon-btn-text">清除图标</text>
        </view>
      </view>
    </view>

    <view class="form-tip">选一个图标</view>
    <view class="icon-grid">
      <view
        wx:for="{{bookIcons}}"
        wx:key="key"
        class="icon-pick {{item.key === formIconKey ? 'icon-pick-on' : ''}}"
        data-key="{{item.key}}"
        bindtap="onSelectIcon"
        hover-class="tap-hover"
      >
        <app-icon icon-key="{{item.key}}" emoji="🖼️" size="{{44}}" />
      </view>
    </view>
    <view class="btn btn-primary form-btn" bindtap="onSubmit" hover-class="btn-hover">
      <text>保存</text>
    </view>
  </sheet>
</view>
